import React, { useState, useEffect, useRef } from 'react'
import {
  PaperAirplaneIcon,
  SparklesIcon,
  ClockIcon,
  ArrowPathIcon,
  AdjustmentsHorizontalIcon,
  Bars3Icon,
  PlusIcon,
  TrashIcon,
  ChatBubbleLeftRightIcon,
  MagnifyingGlassIcon,
  XMarkIcon,
  DocumentArrowDownIcon,
  MicrophoneIcon,
  DocumentTextIcon,
  SpeakerWaveIcon,
  StopIcon,
} from '@heroicons/react/24/outline'
import { mlAPI } from '../../services/api.js'
import toast from 'react-hot-toast'

// AI PERSONALITY PRESETS
const AI_PERSONALITIES = [
  { 
    id: 'professional', 
    name: '👔 Professional', 
    description: 'Formal, business-like, structured responses',
    systemPrompt: 'You are a professional business consultant. Provide formal, structured, and detailed advice.'
  },
  { 
    id: 'creative', 
    name: '🎨 Creative', 
    description: 'Out-of-the-box thinking, innovative ideas',
    systemPrompt: 'You are a creative innovation coach. Think outside the box, suggest creative solutions.'
  },
  { 
    id: 'friendly', 
    name: '😊 Friendly', 
    description: 'Warm, encouraging, conversational',
    systemPrompt: 'You are a friendly and encouraging mentor. Be warm, supportive, and conversational.'
  },
  { 
    id: 'technical', 
    name: '💻 Technical', 
    description: 'Deep technical analysis, data-driven',
    systemPrompt: 'You are a technical expert. Provide in-depth technical analysis and data-driven insights.'
  },
  { 
    id: 'coach', 
    name: '🏆 Coach', 
    description: 'Motivational, action-oriented, goal-focused',
    systemPrompt: 'You are a motivational coach. Focus on goals, action steps, and accountability.'
  },
]

const SUGGESTED_QUESTIONS = [
  'Startup Grant Guidelines?',
  'Market Entry Strategy?',
  'Pitch Deck Review',
]

const generateId = () => Date.now().toString(36) + Math.random().toString(36).substr(2, 5)

export default function Chatbot() {
  // STATE
  const [conversations, setConversations] = useState(() => {
    const saved = localStorage.getItem('chatbot_conversations')
    if (saved) {
      try { return JSON.parse(saved) } catch { /* fallback */ }
    }
    return [
      { id: '1', title: 'Government Policies', subtitle: 'Innovation FAQs', messages: [] },
      { id: '2', title: 'Project Alpha Discussion', subtitle: 'Lucide 4 hours ago', messages: [] },
      { id: '3', title: 'Startup Grant Guidelines', subtitle: 'Lucide 3 hours ago', messages: [] },
    ]
  })

  const [selectedConversationId, setSelectedConversationId] = useState('1')
  const [input, setInput] = useState('')
  const [isLoading, setIsLoading] = useState(false)
  const [sidebarOpen, setSidebarOpen] = useState(true)
  
  // AI Personality
  const [selectedPersonality, setSelectedPersonality] = useState(AI_PERSONALITIES[0])
  const [showPersonalitySelector, setShowPersonalitySelector] = useState(false)

  // Search
  const [searchQuery, setSearchQuery] = useState('')
  const [isSearchOpen, setIsSearchOpen] = useState(false)
  const [searchResults, setSearchResults] = useState([])

  // Conversation Search
  const [convSearchQuery, setConvSearchQuery] = useState('')
  const [filteredConversations, setFilteredConversations] = useState([])

  // Typing Indicator
  const [isTyping, setIsTyping] = useState(false)

  // ✅ VOICE CONVERSATION STATE
  const [isRecording, setIsRecording] = useState(false)
  const [isSpeaking, setIsSpeaking] = useState(false)
  const [isVoiceConversation, setIsVoiceConversation] = useState(false)
  const recognitionRef = useRef(null)
  const messagesEndRef = useRef(null)
  const searchInputRef = useRef(null)

  const currentConversation = conversations.find(c => c.id === selectedConversationId)
  const messages = currentConversation?.messages || []

  // EFFECTS
  useEffect(() => {
    localStorage.setItem('chatbot_conversations', JSON.stringify(conversations))
  }, [conversations])

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  }, [messages])

  // Filter conversations for search
  useEffect(() => {
    if (convSearchQuery.trim()) {
      const query = convSearchQuery.toLowerCase()
      const filtered = conversations.filter(conv => 
        conv.title.toLowerCase().includes(query) ||
        conv.messages.some(m => m.content.toLowerCase().includes(query))
      )
      setFilteredConversations(filtered)
    } else {
      setFilteredConversations(conversations)
    }
  }, [convSearchQuery, conversations])

  // CHAT FUNCTIONS
  const handleSend = async (userMessage) => {
    const message = userMessage || input.trim()
    if (!message) return

    const userMsg = {
      id: generateId(),
      role: 'user',
      content: message,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    }

    setConversations(prev => prev.map(conv => {
      if (conv.id === selectedConversationId) {
        const newTitle = conv.messages.length === 0 ? message.slice(0, 30) + (message.length > 30 ? '...' : '') : conv.title
        return { ...conv, title: newTitle, messages: [...conv.messages, userMsg] }
      }
      return conv
    }))

    setInput('')
    setIsLoading(true)
    setIsTyping(true)

    try {
      const response = await mlAPI.chat(message, {
        personality: selectedPersonality.name,
        personalityPrompt: selectedPersonality.systemPrompt,
      })
      const reply = response.data?.data?.reply || response.data?.data?.response || "I'm sorry, I couldn't generate a response."

      const aiMsg = {
        id: generateId(),
        role: 'assistant',
        content: reply,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      }

      setConversations(prev => prev.map(conv => {
        if (conv.id === selectedConversationId) {
          return { ...conv, messages: [...conv.messages, aiMsg] }
        }
        return conv
      }))

      // ✅ If voice conversation mode is on, speak the response
      if (isVoiceConversation) {
        speakResponse(reply)
      }

    } catch (error) {
      console.error('Chat error:', error)
      toast.error('AI service unavailable')
    } finally {
      setIsLoading(false)
      setIsTyping(false)
    }
  }

  // ============================================================
  // ✅ VOICE CONVERSATION FUNCTIONS
  // ============================================================

  // Start voice conversation
  const startVoiceConversation = () => {
    if (isVoiceConversation) {
      // Stop voice conversation
      setIsVoiceConversation(false)
      if (recognitionRef.current) {
        try { recognitionRef.current.stop() } catch (e) {}
      }
      window.speechSynthesis.cancel()
      setIsRecording(false)
      setIsSpeaking(false)
      toast.success('🔇 Voice conversation ended')
      return
    }

    // Check if browser supports speech recognition
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition
    if (!SpeechRecognition) {
      toast.error('Voice recognition not supported. Please use Chrome, Edge, or Safari.')
      return
    }

    // Request microphone permission
    navigator.mediaDevices.getUserMedia({ audio: true })
      .then(() => {
        setIsVoiceConversation(true)
        toast.success('🎙️ Voice conversation started! Speak to the AI.')
        // Start listening after a short delay
        setTimeout(() => startListening(), 500)
      })
      .catch(() => {
        toast.error('Microphone access denied. Please allow microphone in browser settings.')
      })
  }

  // Start listening for user speech
  const startListening = () => {
    if (!isVoiceConversation) return

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition
    const recognition = new SpeechRecognition()
    recognition.lang = 'en-US'
    recognition.continuous = true
    recognition.interimResults = true
    recognition.maxAlternatives = 1
    recognitionRef.current = recognition

    let finalTranscript = ''

    recognition.onstart = () => {
      console.log('🎤 Listening...')
      setIsRecording(true)
      toast.info('🎤 Listening... Speak now', { duration: 2000 })
    }

    recognition.onresult = (event) => {
      let interimTranscript = ''
      for (let i = event.resultIndex; i < event.results.length; i++) {
        const transcript = event.results[i][0].transcript
        if (event.results[i].isFinal) {
          finalTranscript += transcript
        } else {
          interimTranscript += transcript
        }
      }
      // Show what user is saying
      if (finalTranscript) {
        setInput(finalTranscript)
        // If there's a pause, send the message
        clearTimeout(recognition.sendTimeout)
        recognition.sendTimeout = setTimeout(() => {
          if (finalTranscript.trim()) {
            handleSend(finalTranscript.trim())
            finalTranscript = ''
            setInput('')
          }
        }, 1000)
      } else if (interimTranscript) {
        setInput(interimTranscript + '...')
      }
    }

    recognition.onerror = (event) => {
      console.error('Voice error:', event.error)
      if (event.error === 'not-allowed') {
        toast.error('Please allow microphone access')
        setIsVoiceConversation(false)
        setIsRecording(false)
      } else if (event.error === 'no-speech') {
        // Continue listening
        console.log('No speech detected, continuing...')
      }
    }

    recognition.onend = () => {
      console.log('🎤 Listening ended')
      setIsRecording(false)
      // If voice conversation is still active, restart listening
      if (isVoiceConversation) {
        setTimeout(() => startListening(), 1000)
      }
    }

    recognition.start()
  }

  // Speak AI response
  const speakResponse = (text) => {
    if (!('speechSynthesis' in window)) {
      toast.error('Text-to-speech not supported')
      return
    }

    // Cancel any ongoing speech
    window.speechSynthesis.cancel()

    const utterance = new SpeechSynthesisUtterance(text)
    utterance.lang = 'en-US'
    utterance.rate = 0.9
    utterance.pitch = 1
    utterance.volume = 1

    // Split long text into shorter sentences for better speech
    const sentences = text.match(/[^.!?]+[.!?]+/g) || [text]
    let index = 0

    utterance.onstart = () => {
      setIsSpeaking(true)
    }

    utterance.onend = () => {
      index++
      if (index < sentences.length) {
        // Speak next sentence
        const nextUtterance = new SpeechSynthesisUtterance(sentences[index])
        nextUtterance.lang = 'en-US'
        nextUtterance.rate = 0.9
        nextUtterance.pitch = 1
        nextUtterance.volume = 1
        nextUtterance.onstart = () => { setIsSpeaking(true) }
        nextUtterance.onend = () => { 
          if (index >= sentences.length - 1) {
            setIsSpeaking(false)
            // Resume listening after speaking
            if (isVoiceConversation) {
              setTimeout(() => {
                if (!isRecording) {
                  startListening()
                }
              }, 500)
            }
          }
        }
        window.speechSynthesis.speak(nextUtterance)
      } else {
        setIsSpeaking(false)
        // Resume listening after speaking
        if (isVoiceConversation) {
          setTimeout(() => {
            if (!isRecording) {
              startListening()
            }
          }, 500)
        }
      }
    }

    utterance.onerror = () => {
      setIsSpeaking(false)
      if (isVoiceConversation) {
        setTimeout(() => {
          if (!isRecording) {
            startListening()
          }
        }, 500)
      }
    }

    window.speechSynthesis.speak(utterance)
  }

  // Single voice input (one-time)
  const handleVoiceRecording = () => {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition
    if (!SpeechRecognition) {
      toast.error('Voice recognition not supported. Please use Chrome, Edge, or Safari.')
      return
    }

    if (isRecording) {
      if (recognitionRef.current) {
        try { recognitionRef.current.stop() } catch (e) {}
      }
      setIsRecording(false)
      toast.success('Recording stopped')
      return
    }

    navigator.mediaDevices.getUserMedia({ audio: true })
      .then(() => {
        setIsRecording(true)
        toast.info('🎤 Listening... Speak now', { duration: 3000 })

        const recognition = new SpeechRecognition()
        recognition.lang = 'en-US'
        recognition.continuous = false
        recognition.interimResults = true
        recognition.maxAlternatives = 1
        recognitionRef.current = recognition

        let finalTranscript = ''

        recognition.onstart = () => {
          console.log('Voice recognition started')
        }

        recognition.onresult = (event) => {
          let interimTranscript = ''
          for (let i = event.resultIndex; i < event.results.length; i++) {
            const transcript = event.results[i][0].transcript
            if (event.results[i].isFinal) {
              finalTranscript += transcript
            } else {
              interimTranscript += transcript
            }
          }
          if (finalTranscript) {
            setInput(finalTranscript)
            toast.success('Voice captured!', { duration: 2000 })
          } else if (interimTranscript) {
            setInput(interimTranscript + '...')
          }
        }

        recognition.onerror = (event) => {
          console.error('Voice error:', event.error)
          setIsRecording(false)
          if (event.error === 'not-allowed') {
            toast.error('Please allow microphone access')
          } else if (event.error === 'no-speech') {
            toast.error('No speech detected. Try again.')
          } else {
            toast.error('Voice error: ' + event.error)
          }
        }

        recognition.onend = () => {
          setIsRecording(false)
          if (finalTranscript) {
            setTimeout(() => {
              if (input.trim()) {
                handleSend(input)
              }
            }, 500)
          }
        }

        recognition.start()
      })
      .catch(() => {
        toast.error('Microphone access denied. Please allow microphone in browser settings.')
      })
  }

  const handleSpeak = (text) => {
    if (!('speechSynthesis' in window)) {
      toast.error('Text-to-speech not supported')
      return
    }

    if (isSpeaking) {
      window.speechSynthesis.cancel()
      setIsSpeaking(false)
      toast.success('Speech stopped')
      return
    }

    const utterance = new SpeechSynthesisUtterance(text)
    utterance.lang = 'en-US'
    utterance.rate = 1
    utterance.pitch = 1
    utterance.volume = 1

    utterance.onstart = () => {
      setIsSpeaking(true)
      toast.info('🔊 Speaking...')
    }

    utterance.onend = () => {
      setIsSpeaking(false)
      toast.success('Speech complete')
    }

    utterance.onerror = () => {
      setIsSpeaking(false)
      toast.error('Speech failed')
    }

    window.speechSynthesis.speak(utterance)
  }

  // Other functions
  const handleNewConversation = () => {
    const newConv = { id: generateId(), title: 'New Conversation', subtitle: 'Just now', messages: [] }
    setConversations(prev => [newConv, ...prev])
    setSelectedConversationId(newConv.id)
    toast.success('New conversation started')
  }

  const handleDeleteConversation = (id) => {
    if (conversations.length <= 1) {
      toast.error('Cannot delete the last conversation')
      return
    }
    setConversations(prev => prev.filter(c => c.id !== id))
    if (selectedConversationId === id) {
      setSelectedConversationId(conversations.find(c => c.id !== id)?.id || '')
    }
    toast.success('Conversation deleted')
  }

  const handleRefresh = async () => {
    const conv = conversations.find(c => c.id === selectedConversationId)
    if (!conv || conv.messages.length === 0) {
      toast.error('No messages to refresh')
      return
    }

    const lastUserMsg = [...conv.messages].reverse().find(m => m.role === 'user')
    if (!lastUserMsg) {
      toast.error('No user message to refresh')
      return
    }

    const lastMsg = conv.messages[conv.messages.length - 1]
    if (lastMsg.role === 'assistant') {
      setConversations(prev => prev.map(c => {
        if (c.id === selectedConversationId) {
          return { ...c, messages: c.messages.slice(0, -1) }
        }
        return c
      }))
    }

    setIsLoading(true)
    setIsTyping(true)
    try {
      const response = await mlAPI.chat(lastUserMsg.content, {
        personality: selectedPersonality.name,
        personalityPrompt: selectedPersonality.systemPrompt,
      })
      const reply = response.data?.data?.reply || response.data?.data?.response || "I'm sorry, I couldn't generate a response."

      const aiMsg = {
        id: generateId(),
        role: 'assistant',
        content: reply,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      }

      setConversations(prev => prev.map(c => {
        if (c.id === selectedConversationId) {
          return { ...c, messages: [...c.messages, aiMsg] }
        }
        return c
      }))
      toast.success('Response regenerated')
    } catch (error) {
      toast.error('Failed to refresh')
    } finally {
      setIsLoading(false)
      setIsTyping(false)
    }
  }

  const handleSuggestedQuestion = (question) => {
    setInput(question)
    setTimeout(() => handleSend(question), 100)
  }

  const handleKeyPress = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      handleSend()
    }
  }

  const getConversationTime = (conv) => {
    if (conv.messages.length === 0) return conv.subtitle || 'No messages'
    const lastMsg = conv.messages[conv.messages.length - 1]
    return lastMsg.timestamp || 'Just now'
  }

  const handleSearch = (query) => {
    setSearchQuery(query)
    if (query.trim()) {
      const results = messages.filter(msg => 
        msg.content.toLowerCase().includes(query.toLowerCase())
      )
      setSearchResults(results)
    } else {
      setSearchResults([])
    }
  }

  const clearSearch = () => {
    setSearchQuery('')
    setSearchResults([])
    setIsSearchOpen(false)
  }

  const handleConversationSearch = (query) => {
    setConvSearchQuery(query)
  }

  const displayConversations = convSearchQuery.trim() ? filteredConversations : conversations

  return (
    <div className="h-[calc(100vh-120px)] flex gap-4 relative">
      {/* Sidebar */}
      <div className={`${sidebarOpen ? 'w-72' : 'w-0'} flex-shrink-0 transition-all duration-400 overflow-hidden lg:w-72 lg:overflow-visible relative z-10`}>
        <div className="h-full bg-white/70 backdrop-blur-2xl rounded-3xl border border-white/30 shadow-[0_8px_40px_rgba(0,0,0,0.06)] p-5 flex flex-col">
          <div className="flex items-center justify-between mb-5">
            <h3 className="font-semibold text-ink text-sm flex items-center gap-2.5">
              <div className="h-8 w-8 rounded-xl bg-gradient-to-br from-[#1D4241] to-[#EF9C82] flex items-center justify-center shadow-lg">
                <ChatBubbleLeftRightIcon className="h-4 w-4 text-white" />
              </div>
              <span className="text-[#1D4241]">Conversations</span>
            </h3>
            <button onClick={handleNewConversation} className="h-8 w-8 rounded-xl bg-gradient-to-br from-[#1D4241] to-[#163535] text-white hover:shadow-lg hover:shadow-[#1D4241]/20 transition-all flex items-center justify-center">
              <PlusIcon className="h-4 w-4" />
            </button>
          </div>

          <div className="mb-3 relative">
            <input
              type="text"
              value={convSearchQuery}
              onChange={(e) => handleConversationSearch(e.target.value)}
              placeholder="Search conversations..."
              className="w-full px-3 py-1.5 text-sm bg-white/60 backdrop-blur-sm border border-gray-200/50 rounded-xl focus:ring-2 focus:ring-[#1D4241]/30 focus:border-transparent outline-none transition-all placeholder:text-slate-400"
            />
            {convSearchQuery && (
              <button onClick={() => setConvSearchQuery('')} className="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                <XMarkIcon className="h-4 w-4" />
              </button>
            )}
          </div>

          <div className="flex-1 overflow-y-auto space-y-1.5 pr-1 custom-scrollbar">
            {displayConversations.map((conv) => (
              <div key={conv.id} className={`group flex items-center gap-1 rounded-2xl transition-all duration-300 ${selectedConversationId === conv.id ? 'bg-gradient-to-r from-[#1D4241]/10 to-[#EF9C82]/5 shadow-sm' : 'hover:bg-gray-50/80'}`}>
                <button className="flex-1 text-left p-3 rounded-2xl" onClick={() => setSelectedConversationId(conv.id)}>
                  <p className={`text-sm font-medium truncate ${selectedConversationId === conv.id ? 'text-[#1D4241]' : 'text-ink'}`}>{conv.title}</p>
                  <div className="flex items-center gap-2 mt-0.5">
                    <ClockIcon className="h-3 w-3 text-slate-400" />
                    <p className="text-xs text-slate-400 truncate">{getConversationTime(conv)}</p>
                  </div>
                </button>
                <button onClick={() => handleDeleteConversation(conv.id)} className="opacity-0 group-hover:opacity-100 p-2 rounded-xl text-slate-400 hover:text-red-500 hover:bg-red-50 transition-all duration-300">
                  <TrashIcon className="h-3.5 w-3.5" />
                </button>
              </div>
            ))}
            {displayConversations.length === 0 && (
              <p className="text-sm text-slate-400 text-center py-4">No conversations found</p>
            )}
          </div>
        </div>
      </div>

      {/* Chat Area */}
      <div className="flex-1 flex flex-col bg-white/70 backdrop-blur-2xl rounded-3xl border border-white/30 shadow-[0_8px_40px_rgba(0,0,0,0.06)] overflow-hidden relative z-10">
        {/* Header */}
        <div className="p-5 border-b border-white/30 flex items-center justify-between bg-white/40 backdrop-blur-sm">
          <div className="flex items-center gap-3.5">
            <button className="lg:hidden text-slate-400 hover:text-[#1D4241] transition-all" onClick={() => setSidebarOpen(!sidebarOpen)}>
              <Bars3Icon className="h-5 w-5" />
            </button>
            <div className="flex items-center gap-3.5">
              <div className="h-11 w-11 rounded-2xl bg-gradient-to-br from-[#1D4241] to-[#EF9C82] flex items-center justify-center shadow-lg shadow-[#1D4241]/10">
                <SparklesIcon className="h-5.5 w-5.5 text-white" />
              </div>
              <div>
                <h2 className="font-heading font-semibold text-ink text-lg">{currentConversation?.title || 'AI Chat Assistant'}</h2>
                <div className="flex items-center gap-2">
                  <span className="text-xs text-slate-400">Groq AI • Real-time</span>
                  <span className="text-xs text-[#1D4241] font-medium bg-[#1D4241]/10 px-2 py-0.5 rounded-full">
                    {selectedPersonality.name}
                  </span>
                  {isVoiceConversation && (
                    <span className="text-xs bg-red-500 text-white px-2 py-0.5 rounded-full animate-pulse">
                      🎤 Voice Mode
                    </span>
                  )}
                </div>
              </div>
            </div>
          </div>
          <div className="flex items-center gap-2">
            {/* ✅ Voice Conversation Toggle Button */}
            <button
              onClick={startVoiceConversation}
              className={`h-9 w-9 rounded-xl transition-all duration-300 flex items-center justify-center ${
                isVoiceConversation 
                  ? 'bg-red-500 text-white animate-pulse shadow-lg shadow-red-500/30' 
                  : 'text-slate-400 hover:text-[#1D4241] hover:bg-[#1D4241]/5'
              }`}
              title={isVoiceConversation ? 'Stop voice conversation' : 'Start voice conversation'}
            >
              <MicrophoneIcon className={`h-4.5 w-4.5 ${isVoiceConversation ? 'animate-pulse' : ''}`} />
            </button>

            <button
              onClick={() => setIsSearchOpen(!isSearchOpen)}
              className="h-9 w-9 rounded-xl transition-all duration-300 flex items-center justify-center text-slate-400 hover:text-[#1D4241] hover:bg-[#1D4241]/5"
            >
              <MagnifyingGlassIcon className="h-4.5 w-4.5" />
            </button>

            <button
              onClick={() => {
                const lastAI = [...messages].reverse().find(m => m.role === 'assistant')
                if (lastAI) handleSpeak(lastAI.content)
                else toast.error('No AI message to speak')
              }}
              className={`h-9 w-9 rounded-xl transition-all duration-300 flex items-center justify-center ${
                isSpeaking 
                  ? 'text-[#EF9C82] bg-[#EF9C82]/10 animate-pulse' 
                  : 'text-slate-400 hover:text-[#1D4241] hover:bg-[#1D4241]/5'
              }`}
              title="Read last response aloud"
            >
              <SpeakerWaveIcon className={`h-4.5 w-4.5 ${isSpeaking ? 'animate-pulse' : ''}`} />
            </button>

            <button
              onClick={() => setShowPersonalitySelector(!showPersonalitySelector)}
              className="h-9 w-9 rounded-xl transition-all duration-300 flex items-center justify-center text-slate-400 hover:text-[#1D4241] hover:bg-[#1D4241]/5 relative"
              title="Change AI Personality"
            >
              <AdjustmentsHorizontalIcon className="h-4.5 w-4.5" />
              {showPersonalitySelector && (
                <div className="absolute right-0 top-11 w-56 bg-white/90 backdrop-blur-2xl rounded-2xl border border-white/30 shadow-lg p-2 z-20">
                  {AI_PERSONALITIES.map((p) => (
                    <button
                      key={p.id}
                      onClick={() => {
                        setSelectedPersonality(p)
                        setShowPersonalitySelector(false)
                        toast.success(`Switched to ${p.name} personality`)
                      }}
                      className={`w-full text-left p-2.5 rounded-xl transition-all ${
                        selectedPersonality.id === p.id 
                          ? 'bg-[#1D4241]/10 text-[#1D4241]' 
                          : 'hover:bg-gray-50 text-slate-600'
                      }`}
                    >
                      <p className="text-sm font-medium">{p.name}</p>
                      <p className="text-xs text-slate-400 truncate">{p.description}</p>
                    </button>
                  ))}
                </div>
              )}
            </button>

            <button onClick={handleRefresh} disabled={isLoading || messages.length === 0} className={`h-9 w-9 rounded-xl transition-all duration-300 flex items-center justify-center ${isLoading || messages.length === 0 ? 'text-slate-300 cursor-not-allowed' : 'text-slate-400 hover:text-[#1D4241] hover:bg-[#1D4241]/5'}`}>
              <ArrowPathIcon className={`h-4.5 w-4.5 ${isLoading ? 'animate-spin' : ''}`} />
            </button>
          </div>
        </div>

        {/* Search Bar */}
        {isSearchOpen && (
          <div className="px-5 pt-3 pb-2 border-b border-white/20 bg-white/20 backdrop-blur-sm">
            <div className="flex items-center gap-2">
              <input
                ref={searchInputRef}
                type="text"
                value={searchQuery}
                onChange={(e) => handleSearch(e.target.value)}
                placeholder="Search messages..."
                className="flex-1 px-4 py-2 text-sm bg-white/60 backdrop-blur-sm border border-gray-200/50 rounded-xl focus:ring-2 focus:ring-[#1D4241]/30 focus:border-transparent outline-none transition-all"
                autoFocus
              />
              <button onClick={clearSearch} className="p-2 rounded-xl text-slate-400 hover:text-slate-600">
                <XMarkIcon className="h-4 w-4" />
              </button>
            </div>
            {searchResults.length > 0 && (
              <p className="text-xs text-slate-400 mt-2">{searchResults.length} message{searchResults.length > 1 ? 's' : ''} found</p>
            )}
          </div>
        )}

        {/* Messages */}
        <div className="flex-1 overflow-y-auto p-5 space-y-4 custom-scrollbar bg-gradient-to-b from-white/30 to-white/10">
          {messages.length === 0 ? (
            <div className="flex flex-col items-center justify-center h-full text-center">
              <div className="h-20 w-20 rounded-3xl bg-gradient-to-br from-[#1D4241]/10 to-[#EF9C82]/10 flex items-center justify-center mb-5 shadow-inner">
                <SparklesIcon className="h-10 w-10 text-[#1D4241]/30" />
              </div>
              <h3 className="text-slate-600 text-lg font-medium mb-1">No messages yet</h3>
              <p className="text-slate-400 text-sm">Ask a question to start the conversation</p>
              <div className="flex flex-wrap gap-2 mt-4 justify-center">
                {SUGGESTED_QUESTIONS.slice(0, 3).map((q) => (
                  <button key={q} onClick={() => handleSuggestedQuestion(q)} className="text-sm px-4 py-2 rounded-2xl bg-white/60 backdrop-blur-sm border border-gray-200/60 hover:border-[#1D4241]/30 hover:bg-[#1D4241]/5 text-slate-600 transition-all duration-300 shadow-sm hover:shadow-md">
                    {q}
                  </button>
                ))}
              </div>
              <div className="mt-4">
                <button
                  onClick={startVoiceConversation}
                  className="px-6 py-3 rounded-2xl bg-gradient-to-r from-[#1D4241] to-[#163535] text-white hover:shadow-xl hover:shadow-[#1D4241]/20 hover:scale-[1.02] transition-all duration-300 flex items-center gap-2"
                >
                  <MicrophoneIcon className="h-5 w-5" />
                  <span>Start Voice Conversation</span>
                </button>
              </div>
            </div>
          ) : (
            <>
              {(searchQuery.trim() ? searchResults : messages).map((msg, index) => (
                <div key={msg.id} className={`flex flex-col ${msg.role === 'user' ? 'items-end' : 'items-start'} animate-slideUp`} style={{ animationDelay: `${index * 80}ms` }}>
                  <div className={`max-w-[85%] rounded-2xl px-5 py-3.5 shadow-md ${msg.role === 'user' ? 'bg-gradient-to-br from-[#EF9C82]/20 to-[#EF9C82]/5 border border-[#EF9C82]/20' : msg.isError ? 'bg-red-50/80 border border-red-200 text-red-600' : 'bg-white/80 backdrop-blur-sm border border-gray-100/50 text-slate-700 shadow-sm'}`}>
                    <p className="text-sm whitespace-pre-wrap leading-relaxed">
                      {searchQuery.trim() ? (
                        msg.content.split(new RegExp(`(${searchQuery})`, 'gi')).map((part, i) =>
                          part.toLowerCase() === searchQuery.toLowerCase() ? (
                            <span key={i} className="bg-[#EF9C82]/30 text-[#1D4241] font-medium px-0.5 rounded">{part}</span>
                          ) : (
                            part
                          )
                        )
                      ) : (
                        msg.content
                      )}
                    </p>
                  </div>
                  <div className="flex items-center gap-2 mt-1.5 px-1">
                    <ClockIcon className="h-3 w-3 text-slate-300" />
                    <span className="text-xs text-slate-400">{msg.timestamp}</span>
                  </div>
                </div>
              ))}
              {searchQuery.trim() && searchResults.length === 0 && (
                <div className="text-center py-8">
                  <p className="text-slate-400 text-sm">No messages found matching "{searchQuery}"</p>
                </div>
              )}
            </>
          )}

          {isTyping && (
            <div className="flex items-start animate-slideUp">
              <div className="bg-white/80 backdrop-blur-sm border border-gray-100/50 rounded-2xl px-5 py-3.5 shadow-sm">
                <div className="flex gap-1.5">
                  <span className="w-2.5 h-2.5 bg-[#1D4241]/30 rounded-full animate-bounce" />
                  <span className="w-2.5 h-2.5 bg-[#1D4241]/30 rounded-full animate-bounce" style={{ animationDelay: '0.15s' }} />
                  <span className="w-2.5 h-2.5 bg-[#1D4241]/30 rounded-full animate-bounce" style={{ animationDelay: '0.3s' }} />
                </div>
              </div>
            </div>
          )}
          <div ref={messagesEndRef} />
        </div>

        {/* Input */}
        <div className="p-4 border-t border-white/30 bg-white/40 backdrop-blur-sm">
          <div className="flex items-center gap-3">
            {/* Voice Conversation Toggle */}
            <button
              onClick={startVoiceConversation}
              className={`p-3 rounded-2xl transition-all duration-300 flex items-center justify-center ${
                isVoiceConversation 
                  ? 'bg-red-500 text-white animate-pulse shadow-lg shadow-red-500/30' 
                  : 'text-[#1D4241] hover:bg-[#1D4241]/5'
              }`}
              title={isVoiceConversation ? 'Stop voice conversation' : 'Start voice conversation'}
            >
              <MicrophoneIcon className={`h-5 w-5 ${isVoiceConversation ? 'animate-pulse' : ''}`} />
            </button>

            {/* Single Voice Input */}
            <button
              onClick={handleVoiceRecording}
              className={`p-3 rounded-2xl transition-all duration-300 flex items-center justify-center ${
                isRecording && !isVoiceConversation
                  ? 'bg-red-500 text-white animate-pulse shadow-lg shadow-red-500/30' 
                  : 'text-[#1D4241] hover:bg-[#1D4241]/5'
              }`}
              title="Voice input"
              disabled={isVoiceConversation}
            >
              <MicrophoneIcon className={`h-5 w-5 ${isRecording && !isVoiceConversation ? 'animate-pulse' : ''}`} />
            </button>

            <input
              type="text"
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyPress={handleKeyPress}
              placeholder={isVoiceConversation ? '🎙️ Voice conversation mode...' : isRecording ? '🎤 Listening...' : 'Prompt input...'}
              className={`flex-1 px-5 py-3 bg-white/60 backdrop-blur-sm border border-gray-200/50 rounded-2xl focus:ring-2 focus:ring-[#1D4241]/30 focus:border-transparent outline-none text-sm transition-all duration-300 placeholder:text-slate-400 shadow-sm ${
                isRecording && !isVoiceConversation ? 'border-red-300 ring-2 ring-red-300/50' : ''
              } ${isVoiceConversation ? 'border-green-300 ring-2 ring-green-300/50' : ''}`}
              disabled={isLoading || isTyping || isRecording}
            />

            <button
              onClick={() => handleSend()}
              disabled={isLoading || isTyping || isRecording || !input.trim()}
              className={`px-5 py-3 rounded-2xl text-white transition-all duration-300 flex items-center gap-2 shadow-lg ${
                isLoading || isTyping || isRecording || !input.trim() 
                  ? 'bg-slate-300 cursor-not-allowed shadow-none' 
                  : 'bg-gradient-to-r from-[#1D4241] to-[#163535] hover:shadow-xl hover:shadow-[#1D4241]/20 hover:scale-[1.02] active:scale-[0.98]'
              }`}
            >
              <PaperAirplaneIcon className="h-4 w-4" />
            </button>
          </div>

          {/* Status indicators */}
          {isVoiceConversation && (
            <div className="mt-2 text-xs text-green-600 flex items-center gap-2 animate-pulse">
              <span className="w-2 h-2 bg-green-500 rounded-full animate-ping"></span>
              🎙️ Voice conversation active — just speak!
            </div>
          )}
          {isRecording && !isVoiceConversation && (
            <div className="mt-2 text-xs text-red-500 flex items-center gap-2 animate-pulse">
              <span className="w-2 h-2 bg-red-500 rounded-full animate-ping"></span>
              🎤 Recording... Speak now
            </div>
          )}
          {isSpeaking && (
            <div className="mt-2 text-xs text-[#EF9C82] flex items-center gap-2 animate-pulse">
              <span className="w-2 h-2 bg-[#EF9C82] rounded-full animate-ping"></span>
              🔊 AI is speaking...
            </div>
          )}
        </div>
      </div>

      {/* CSS Animations */}
      <style>{`
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #1D4241/20; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #1D4241/40; }
        @keyframes slideUp {
          from { opacity: 0; transform: translateY(16px); }
          to { opacity: 1; transform: translateY(0); }
        }
        .animate-slideUp { animation: slideUp 0.5s ease-out forwards; }
        .animate-pulse { animation: pulse 1.5s ease-in-out infinite; }
        @keyframes pulse {
          0%, 100% { opacity: 1; }
          50% { opacity: 0.5; }
        }
        @keyframes ping {
          0% { transform: scale(1); opacity: 1; }
          100% { transform: scale(2); opacity: 0; }
        }
        .animate-ping { animation: ping 1s ease-in-out infinite; }
      `}</style>
    </div>
  )
}
