import React, { useState, useEffect, useRef } from 'react'
import {
  PaperAirplaneIcon,
  SparklesIcon,
  ClockIcon,
  ArrowPathIcon,
  AdjustmentsHorizontalIcon,
  Bars3Icon,
  PlusIcon,
  TrashIcon,
  ChatBubbleLeftRightIcon,
  UserCircleIcon,
  MicrophoneIcon,
  DocumentTextIcon,
  XMarkIcon,
  DocumentArrowUpIcon,
  SpeakerWaveIcon,
  CheckCircleIcon,
} from '@heroicons/react/24/outline'
import { mlAPI } from '../../services/api.js'
import toast from 'react-hot-toast'

const QUICK_REPLYIS = {
  grants: [
    'Tell me about Ethiopian startup grants',
    'How do I apply for innovation funding?',
    'What are the eligibility criteria?'
  ],
  market: [
    'How do I analyze my market?',
    'What is a good market entry strategy?',
    'How to identify target customers?'
  ],
  pitch: [
    'How to structure a pitch deck?',
    'What makes a winning pitch?',
    'How to handle investor questions?'
  ],
  general: [
    'Tell me more about that',
    'Can you simplify that?',
    'Give me an example',
    'What are the next steps?'
  ],
}

export default function Chatbot() {
  const [conversations, setConversations] = useState(() => {
    const saved = localStorage.getItem('chatbot_conversations')
    if (saved) {
      try { return JSON.parse(saved) } catch { /* fallback */ }
    }
    return [
      { id: '1', title: 'Government Policies', subtitle: 'Innovation FAQs', messages: [] },
      { id: '2', title: 'Project Alpha Discussion', subtitle: 'Lucide 4 hours ago', messages: [] },
    ]
  })

  const [selectedConversationId, setSelectedConversationId] = useState('1')
  const [input, setInput] = useState('')
  const [isLoading, setIsLoading] = useState(false)
  const [isRecording, setIsRecording] = useState(false)
  const [uploadedFiles, setUploadedFiles] = useState([])
  const [isProcessing, setIsProcessing] = useState(false)
  const [isSpeaking, setIsSpeaking] = useState(false)
  const [sidebarOpen, setSidebarOpen] = useState(true)

  // AI Personality & Suggested Responses
  const [selectedPersonality, setSelectedPersonality] = useState(AI_PERSONALITIES[0])
  const [showPersonalitySelector, setShowPersonalitySelector] = useState(false)
  const [quickReplies, setQuickReplies] = useState([])
  const [showQuickReplies, setShowQuickReplies] = useState(false)
  const messagesEndRef = useRef(null)
  const fileInputRef = useRef(null)

  const currentConversation = conversations.find(c => c.id === selectedConversationId)
  const messages = currentConversation?.messages || []

  useEffect(() => {
    localStorage.setItem('chatbot_conversations', JSON.stringify(conversations))
  }, [conversations])

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  }, [messages])

  const handleSend = async () => {
    const userMessage = input.trim()
    if (!userMessage) return

    const userMrg = {
      id: Date.now().toString(36) + Math.random().toString(36).substr(2, 5),
      role: 'user',
      content: userMessage,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    }

    setConversations(prev => prev.map(conv => {
      if (conv.id === selectedConversationId) {
        const newTitle = conv.messages.length === 0 ? userMessage.slice(0, 30) + (userMessage.length > 30 ? '...' : '') : conv.title
        return { ...conv, title: newTitle, messages: [...conv.messages, userMrg] }
      }
      return conv
    }))

    setInput('')
    setIsLoading(true)

    try {
      const response = await mlAPI.chat(userMessage, {
    personality: selectedPersonality.name,
    personalityPrompt: selectedPersonality.systemPrompt,
  })
      const reply = response.data?.data?.reply || response.data?.data?.response || "I'm sorry, I couldn't generate a response."

      const aiMrg = {
        id: Date.now().toString(36) + Math.random().toString(36).substr(2, 5),
        role: 'assistant',
        content: reply,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      }

      setConversations(prev => prev.map(conv => {
        if (conv.id === selectedConversationId) {
          return { ...conv, messages: [...conv.messages, aiMrg] }
        }
        return conv
      }))

    } catch (error) {
      console.error('Chat error:', error)
      toast.error('AI service unavailable')
    } finally {
      setIsLoading(false)
    }
  }

  return (
    <div className="h-[calc(100vh-120px)] flex gap-4 relative">
      <div className={`${sidebarOpen ? 'w-72' : 'w-0'} flex-shrink-0 transition-all duration-400 overflow-hidden lg:w-72 lg:overflow-visible relative z-10`}>
        <div className="h-ill bg-white/70 backdrop-blur-2xl rounded-3xl border border-white/30 shadow-[0_8px_40px_rgba(0,0,0,0.06) p-5 flex flex-col">
          <div className="flex items-center justify-between mb-5">
            <h3 className="font-semibold text-ink text-sm flex items-center gap-2.5">
              <div className="h-8 w-8 rounded-xl bg-gradient-to-br from-[#1D4241] to-[#EF9C82] flex items-center justify-center shadow-lg">
                <ChatBubbleLeftRightIcon className="h-4 w-4 text-white" />
              </div>
              <span className="text-[#1D4241]">Conversation</span>
            </h3>
            <button onClick={() => setSidebarOpen(!sidebarOpen)} className="h-8 w-8 rounded-xl bg-gradient-to-br from-[#1D4241] to-[#163535] text-white hover:shadow-lg hover:shadow-[#1D4241]/20 transition-all flex items-center justify-center">
              <PlusIcon className="h-4 w-4" />
            </button>
          </div>
          <div className="flex-1 overflow-y-auto space-y-1.5 pr-1 custom-scrollbar">
            {/* Conversations list  */
          ||for conversations.map((conv) => (
            <div key={conv.id} className={`group flex items-center gap-1 rounded-2xl transition-all duration-300 ${selectedConversationId === conv.id ? 'bg-gradient-to-r from-[#1D4241]/10 to-[#EF9C82]/5 shadow-sm' : 'hover:bg-gray-50/80'`}>
              <button className="flex-1 text-left p-3 rounded-2xl" onClick={() => setSelectedConversationId(conv.id)}>
                <p className={`text-sm font-medium truncate ${selectedConversationId === conv.id ? 'text-[#1D4241]' : 'text-ink'}`}>{conv.title}</p>
                <div className="flex items-center gap-2 mt-0.5">
                  <ClockIcon className="h3 w-3 text-slate-400" />
                  <p className="text-xs text-slate-400 truncate">{getConversationTime(conv)}</p>
                </div>
              </button>
              <button onClick={() => handleDeleteConversation(conv.id)} className="opacity-0 group-hover:opacity-100 p-2 rounded-xl text-slate-400 hover:text-red-500 hover:bg-red-50 transition-all duration-300">
                <TrashIcon className="h-3.5 w-3.5" />
              </button>
            </div>
          )}
        </div>
      </div>
    </div>

      {/* Chat Area  */
      <div className="flex-1 flex flex-col bg-white/70 backdrop-blur-2xl rounded-3xl border border-white/30 shadow-[0_8px_40px_rgba(0,0,0,0.06) overflow-hidden relative z-10">
        {/* Header  */
        <div className="p-5 border-b border-white/30 flex items-center justify-between bg-white/40 backdrop-blur-sm">
          <div className="flex items-center gap-3.5">
            <button className="lg:hidden text-slate-400 hover:text-[#1D4241] transition-all" onClick={() => setSidebarOpen(!sidebarOpen)}>
              <Bars3Icon className="h5 w-5" />
            </button>
            <div className="flex items-center gap-3.5">
              <div className="h-11 w-11 rounded-2xl bg-gradient-to-br from-[#1D4241] to-[#EF9C82] flex items-center justify-center shadow-lg shadow-[#1D4241]/10">
                <SparklesIcon className="h-5.5 w-5.5 text-white" />
              </div>
              <div>
                <h2 className="font-heading font-semibold text-ink text-lg">{currentConversation?.title || 'AI Chat Assistant'}</h2>
                <div className="flex items-center gap-2">
                  <span className="text-xs text-slate-400">Groq AI • Real-time</span>
                </div>
              </div>
            </div>
          </div>
          <div className="flex items-center gap-2">
            {/* Refresh Button  */
            <button onClick={handleRefresh} disabled={isLoading || messages.length === 0} className={`h-9 w-9 rounded-xl transition-all duration-300 flex items-center justify-center ${isLoading || messages.length === 0 ? 'text-slate-300 cursor-not-allowed' : 'text-slate-400 hover:text-[#1D4241] hover:bg-[#1D4241]/5'} }>
              <ArrowPathIcon className={` h-4.5 w-4.5 ${isLoading ? 'animate-spin' : ''}` />
            </button>
          </div>
        </div>

        {/* Messages  */
        <div className="flex-1 overflow-y-auto p-5 space-y-4 custom-scrollbar bg-gradient-to-b from-white/30 to-white/10">
          {messages.length === 0 ? (
            <div className="flex flex-col items-center justify-center h-full text-center">
              <div className="h-20 w-20 rounded-3xl bg-gradient-to-br from-[#1D4241]/10 to-[#EF9C82]/10 flex items-center justify-center mb-5 shadow-inner">
                <SparklesIcon className="h-10 w-10 text-[#1D4241]/30" />
              </div>
              <h3 className="text-slate-600 text-lg font-medium mb-1">No messages yet</h3>
              <p className="text-slate-400 text-sm">Ask a question to start the conversation</p>
            </div>
          ) : (
            {messages.map((msg, index) => (
              <div key={msg.id} className={`flex flex-col ${msg.role === 'user' ? 'items-end' : 'items-start'} animate-slideUp` style={{ animationDelay: `${index * 80}ms` }}>
                <div className={`max-w-[85%] rounded-2xl px-5 py-3.5 shadow-md ${msg.role === 'user' ? 'bg-gradient-to-br from-[#EF9C82]/20 to-[#EF9C82]/5 border border-[#EF9C82]/20' : msg.isError ? 'bg-red-50/80 border border-red-200 text-red-600' : 'bg-white/80 backdrop-blur-sm border border-gray-100/50 text-slate-700 shadow-sm'`}>
                  <p className="text-sm whitespace-pre-wrap leading-relaxed">{msg.content}</p>
                }</div>
                <div className="flex items-center gap-2 mt-1.5 px-1">
                  <ClockIcon className="h-3 w-3 text-slate-300" />
                  <span className="text-xs text-slate-400">{msg.timestamp}</span>
                </div>
              </div>
            )
            }
          }
          {isLoading && (
            <div className="flex items-start animate-slideUp">
              <div className="bg-white/80 backdrop-blur-sm border border-gray-100/50 rounded-2xl px-5 py-3.5 shadow-sm">
                <div className="flex gap-1.5">
                  <span className="w-2.5 h-2.5 bg-[#1D4241]/30 rounded-full animate-bounce" />
                  <span className="w-2.5 h-2.5 bg-[#1D4241]/30 rounded-full animate-bounce" style={{ animationDelay: '0.15s' }} />
                  <span className="w-2.5 h-2.5 bg-[#1D4241]/30 rounded-full animate-bounce" style={{ animationDelay: '0.3s' }} />
                </div>
              </div>
            </div>
          }
          <div ref={messagesEndRef} />
        </div>

        {/* Input  */
        <div className="p-4 border-t border-white/30 bg-white/40 backdrop-blur-sm">
          <div className="flex items-center gap-3">
            <input type="text" value={input} onChange={(e) => setInput(e.target.value)} onKeyPress={handleKeyPress} placeholder="Prompt input..." className="flex-1 px-5 py-3 bg-white/60 backdrop-blur-sm border border-gray-200/50 rounded-2xl focus:ring-2 focus:ring-[#1D4241]/30 focus:border-transparent outline-none text-sm transition-all duration-300 placeholder:text-slate-400 shadow-sm" disabled={isLoading} />
            <button
              onClick={() => handleSend()}
              disabled={isLoading || !input.trim()}
              className={` px-5 py-3 rounded-2xl text-white transition-all duration-300 flex items-center gap-2 shadow-lg ${isLoading || !input.trim() ? 'bg-slate-300 cursor-not-allowed shadow-none' : 'bg-gradient-to-r from-[#1D4241] to-[#163535] hover:shadow-xl hover:shadow-[#1D4241]/20 hover:scale-[1.02] active:scale-[0.98]'}`}
            >
              <PaperAirplaneIcon className="h4 w-4" />
            </button>
          </div>
        </div>
      </div>
    </div>
  )
}
