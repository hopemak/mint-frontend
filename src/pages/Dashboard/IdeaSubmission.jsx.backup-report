          </div>
          
          <div className="border-b border-gray-200 mb-6">
            <nav className="-mb-px flex gap-6">
              {['overview', 'report'].map(tab => (
                <button
                  key={tab}
                  onClick={() => setActiveTab(tab)}
                  className={`py-2 px-1 border-b-2 font-medium text-sm transition-colors ${
                    activeTab === tab
                      ? 'border-[#1D4241] text-[#1D4241]'
                      : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
                  }`}
                >
                  {tab.charAt(0).toUpperCase() + tab.slice(1)}
                </button>
              ))}
            </nav>
          </div>
          
          {activeTab === 'overview' && (
            <div className="card p-6 space-y-4">
              <div className="bg-gradient-to-r from-[#1D4241] via-[#1D4241]/90 to-[#EF9C82] text-white p-6 rounded-lg">
                <p className="text-sm opacity-80">Overall Score</p>
                <div className="flex items-center gap-4">
                  <span className="text-5xl font-bold">{evaluationResult.overallScore}%</span>
                  <span className="bg-white/20 px-3 py-1 rounded-full text-sm">{evaluationResult.rating}</span>
                  <span className="bg-white/10 px-3 py-1 rounded-full text-sm">Status: {evaluationResult.approval_status}</span>
                </div>
              </div>
              <div className="grid sm:grid-cols-3 lg:grid-cols-6 gap-3">
                {Object.entries(evaluationResult.scores).map(([k, v]) => (
                  <div key={k} className="bg-gray-50 p-3 rounded-lg">
                    <p className="text-xs text-gray-500 capitalize">{k.replace(/([A-Z])/g, ' $1')}</p>
                    <p className="text-xl font-bold">{v}%</p>
                    <div className="h-1.5 bg-gray-200 rounded-full mt-1"><div className="h-full bg-[#1D4241] rounded-full" style={{ width: `${v}%` }} /></div>
                  </div>
                ))}
              </div>
              <div className="grid grid-cols-2 gap-4">
                <div className="bg-emerald-50 p-4 rounded-lg border border-emerald-100"><p className="font-medium text-emerald-700 flex items-center gap-1"><CheckCircleIcon className="h-4 w-4" /> Strengths</p><ul className="text-sm text-emerald-600 space-y-1 mt-1">{evaluationResult.swot.strengths.map((s, i) => <li key={i}>• {s}</li>)}</ul></div>
                <div className="bg-red-50 p-4 rounded-lg border border-red-100"><p className="font-medium text-red-700 flex items-center gap-1"><ExclamationTriangleIcon className="h-4 w-4" /> Weaknesses</p><ul className="text-sm text-red-600 space-y-1 mt-1">{evaluationResult.swot.weaknesses.map((s, i) => <li key={i}>• {s}</li>)}</ul></div>
                <div className="bg-blue-50 p-4 rounded-lg border border-blue-100"><p className="font-medium text-blue-700 flex items-center gap-1"><LightBulbIcon className="h-4 w-4" /> Opportunities</p><ul className="text-sm text-blue-600 space-y-1 mt-1">{evaluationResult.swot.opportunities.map((s, i) => <li key={i}>• {s}</li>)}</ul></div>
                <div className="bg-amber-50 p-4 rounded-lg border border-amber-100"><p className="font-medium text-amber-700 flex items-center gap-1"><ExclamationTriangleIcon className="h-4 w-4" /> Threats</p><ul className="text-sm text-amber-600 space-y-1 mt-1">{evaluationResult.swot.threats.map((s, i) => <li key={i}>• {s}</li>)}</ul></div>
              </div>
              <div className="bg-gray-50 p-4 rounded-lg"><p className="font-medium text-ink mb-2">Risk Analysis</p><div className="space-y-2">{evaluationResult.risks.map((r, i) => <div key={i} className="flex items-center justify-between border-b border-gray-200 pb-2"><span className="text-sm">{r.name}</span><span className={`text-xs px-2 py-0.5 rounded-full ${r.level === 'High' ? 'bg-red-100 text-red-600' : r.level === 'Medium' ? 'bg-amber-100 text-amber-600' : 'bg-green-100 text-green-600'}`}>{r.level}</span></div>)}</div></div>
            </div>
          )}
          
          {activeTab === 'report' && (
            <div className="card p-6">
              <div ref={reportRef} className="bg-white p-8 rounded-lg border border-gray-200">
                <pre className="text-sm text-gray-800 whitespace-pre-wrap font-mono leading-relaxed">
                  {evaluationResult.detailedFeedback}
                </pre>
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  )
}
