  }

  // ============================================================
  // ✅ EXPORT TO PDF
  // ============================================================
  const handleExportPDF = async () => {
    if (!evaluationResult) {
      toast.error('No evaluation results to export')
      return
    }
    setIsExporting(true)
    await exportToPDF(reportRef.current, `evaluation_report_${Date.now()}.pdf`)
    setIsExporting(false)
  }

  return (
    <div>
      <PageHeader 
        eyebrow="Innovation Incubator Platform" 
        title="AI Idea Submission Portal" 
        description="Share your idea and get AI-powered evaluation instantly." 
      />
      <div className="grid lg:grid-cols-3 gap-6">
        <form onSubmit={handleSubmit(onSubmit)} className="lg:col-span-2 card p-6 space-y-5">
          <div className="grid sm:grid-cols-3 gap-5">
            <div className="sm:col-span-1">
              <label className="label">Idea Title *</label>
              <input className="input" placeholder="e.g. AgriSense AI" {...register('title')} />
            </div>
            <div>
              <label className="label">Category</label>
              <select className="input" {...register('category')}>
                <option value="">Select</option>
                {CATEGORIES.map(c => <option key={c} value={c}>{c}</option>)}
              </select>
            </div>
            <div>
              <label className="label">Industry</label>
              <select className="input" {...register('industry')}>
                <option value="">Select</option>
                {INDUSTRIES.map(i => <option key={i} value={i}>{i}</option>)}
              </select>
            </div>
          </div>
          <div className="grid sm:grid-cols-2 gap-5">
            <div>
              <label className="label">Problem Statement *</label>
              <textarea rows={5} className="input" placeholder="What problem does it solve?" {...register('problem')} />
            </div>
            <div>
              <label className="label">Solution</label>
              <textarea rows={5} className="input" placeholder="How does it solve it?" {...register('solution')} />
            </div>
          </div>
          <div className="grid sm:grid-cols-2 gap-5">
            <div>
              <label className="label">Target Market</label>
              <input className="input" placeholder="Who is this for?" {...register('target_market')} />
            </div>
            <div>
              <label className="label">Business Model</label>
              <select className="input" {...register('business_model')}>
                <option value="">Select</option>
                {BUSINESS_MODELS.map(m => <option key={m} value={m}>{m}</option>)}
              </select>
            </div>
          </div>
          <div>
            <label className="label">Innovation Level ({innovationLevel || 5}/10)</label>
            <div className="flex items-center gap-4">
              <input type="range" min="1" max="10" className="w-full accent-[#1D4241]" {...register('innovation_level')} />
              <span className="text-2xl font-bold text-[#1D4241] min-w-[40px] text-center">{innovationLevel || 5}</span>
            </div>
          </div>
          <div className="grid sm:grid-cols-2 gap-5">
            <div>
              <label className="label">Documents</label>
              <div className="flex items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-200 px-4 py-6 text-sm text-slate-500 cursor-pointer hover:border-[#1D4241]" onClick={() => fileInputRef.current?.click()}>
                <DocumentArrowUpIcon className="h-5 w-5" /> Upload files
                <input ref={fileInputRef} type="file" className="hidden" multiple onChange={handleFileUpload} />
              </div>
              {uploadedFiles.length > 0 && uploadedFiles.map(f => (
                <div key={f.id} className="flex items-center justify-between bg-gray-50 p-2 rounded-lg mt-2">
                  <div className="flex items-center gap-2"><DocumentTextIcon className="h-5 w-5 text-[#1D4241]" /><span className="text-sm">{f.name}</span><span className="text-xs text-gray-400">({f.size} KB)</span></div>
                  <button type="button" onClick={() => removeFile(f.id)} className="text-gray-400 hover:text-red-500"><XMarkIcon className="h-5 w-5" /></button>
                </div>
              ))}
            </div>
            <div>
              <label className="label">Pitch Deck</label>
              <div className="flex items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-200 px-4 py-6 text-sm text-slate-500 cursor-pointer hover:border-[#1D4241]">
                <DocumentArrowUpIcon className="h-5 w-5" /> Upload deck
                <input type="file" className="hidden" {...register('pitchDeck')} />
              </div>
            </div>
          </div>
          <div className="flex gap-3 pt-4">
            <button type="submit" disabled={isSubmitting || isEvaluating} className={`px-6 py-2.5 rounded-lg text-white transition-all flex items-center gap-2 ${isSubmitting || isEvaluating ? 'bg-gray-400 cursor-not-allowed' : 'bg-[#1D4241] hover:bg-[#163535]'}`}>
              {isSubmitting || isEvaluating ? <><span className="animate-spin">⏳</span>{isEvaluating ? 'Evaluating...' : 'Submitting...'}</> : <><SparklesIcon className="h-5 w-5" />Submit & Evaluate</>}
            </button>
            <button type="button" onClick={() => reset()} className="px-6 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50">Reset</button>
          </div>
        </form>
        
        <aside className="card p-6 h-fit sticky top-20">
          <div className="flex items-center justify-between mb-5"><h2 className="font-heading font-semibold text-ink">AI Assistant</h2><button className="text-slate-400 hover:text-slate-600"><EllipsisHorizontalIcon className="h-5 w-5" /></button></div>
          <div className="flex justify-center mb-5"><div className="h-28 w-28 rounded-full bg-gradient-to-br from-[#1D4241] via-[#1D4241]/90 to-[#EF9C82] flex items-center justify-center shadow-lg"><CpuChipIcon className="h-12 w-12 text-white" /></div></div>
          <div className="rounded-xl bg-slate-50 p-4 text-center mb-4"><p className="text-sm text-slate-500 mb-1">Idea Quality Score</p><Gauge value={scores.quality} size={160} centerLabel={scores.quality} /></div>
          <div className="grid grid-cols-2 gap-3 mb-4">
            <div className="rounded-xl border border-slate-100 p-3 text-center"><p className="text-xs text-slate-500">Innovation</p><p className="font-heading font-semibold text-ink">{scores.innovation || 50}/100</p></div>
            <div className="rounded-xl border border-slate-100 p-3 text-center"><p className="text-xs text-slate-500">Feasibility</p><p className="font-heading font-semibold text-ink">{scores.feasibility || 70}%</p></div>
            <div className="rounded-xl border border-slate-100 p-3 text-center"><p className="text-xs text-slate-500">Market</p><p className="font-heading font-semibold text-ink">{scores.market || 70}%</p></div>
            <div className="rounded-xl border border-slate-100 p-3 text-center"><p className="text-xs text-slate-500">Risk</p><span className="inline-block rounded-full bg-[#1D4241] text-white text-xs font-semibold px-2.5 py-1">{scores.risk || 30}%</span></div>
          </div>
          <div className="rounded-xl bg-[#EF9C82]/10 border border-[#EF9C82]/20 p-4 flex gap-2.5 mb-4">
            <ExclamationTriangleIcon className="h-5 w-5 text-[#EF9C82] shrink-0" />
            <div><p className="text-sm font-medium text-[#EF9C82]">Duplicate Check</p><p className="text-xs text-slate-500">No similar ideas found</p></div>
          </div>
          <button type="submit" form="idea-form" disabled={isSubmitting} className="btn-primary w-full py-3">{isSubmitting ? 'Submitting...' : 'Submit Idea'}</button>
        </aside>
      </div>

      {evaluationResult && (
        <div className="mt-8">
          <div className="flex items-center justify-between mb-4">
            <h2 className="font-heading font-semibold text-ink text-xl">Evaluation Results</h2>
            <div className="flex gap-2">
              <button
                onClick={handleExportPDF}
                disabled={isExporting}
                className={`px-4 py-2 rounded-lg text-sm flex items-center gap-2 ${
                  isExporting 
                    ? 'bg-gray-200 text-gray-400 cursor-not-allowed' 
                    : 'bg-[#1D4241] text-white hover:bg-[#163535]'
                }`}
              >
                <ArrowDownTrayIcon className="h-4 w-4" />
                {isExporting ? 'Exporting...' : 'Export PDF'}
