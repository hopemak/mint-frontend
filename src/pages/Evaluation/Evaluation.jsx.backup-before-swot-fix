            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              {displayData.suggestedImprovements && displayData.suggestedImprovements.length > 0 ? (
                displayData.suggestedImprovements.map((s, i) => {
                  const Icon = improvementIcons[i % improvementIcons.length]
                  return (
                    <div
