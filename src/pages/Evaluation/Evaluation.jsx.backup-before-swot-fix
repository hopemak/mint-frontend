        <aside className="lg:col-span-1 space-y-6 h-fit lg:sticky lg:top-20">
          <div className="card p-5">
            <h2 className="font-heading font-semibold text-ink dark:text-white mb-3 flex items-center gap-2">
              <ChatBubbleLeftIcon className="h-5 w-5 text-[#1D4241]" />
              AI Chat Assistant
            </h2>
            <div className="space-y-2.5 mb-3 max-h-[200px] overflow-y-auto">
              {chatMessages.length > 0 ? (
                chatMessages.map((msg, idx) => (
                  <div key={idx} className={`flex gap-2 ${msg.role === 'user' ? 'flex-row-reverse' : ''}`}>
                    <div className={`h-6 w-6 rounded-full flex items-center justify-center shrink-0 ${msg.role === 'user' ? 'bg-[#EF9C82]' : 'bg-[#1D4241]'}`}>
                      <ChatBubbleLeftIcon className="h-3.5 w-3.5 text-white" />
                    </div>
                    <p className={`rounded-xl p-2.5 text-xs max-w-[85%] ${msg.role === 'user' ? 'bg-[#EF9C82]/10 text-ink' : 'bg-slate-50 text-slate-600'}`}>
                      {msg.text}
                    </p>
                  </div>
                ))
              ) : (
                <div className="flex gap-2">
                  <div className="h-6 w-6 rounded-full bg-[#1D4241] text-white flex items-center justify-center shrink-0">
                    <ChatBubbleLeftIcon className="h-3.5 w-3.5" />
                  </div>
                  <p className="rounded-xl bg-slate-50 p-2.5 text-xs text-slate-600">
                    {aiFeedback}
                  </p>
                </div>
              )}
              {isChatSending && (
                <div className="flex gap-2">
                  <div className="h-6 w-6 rounded-full bg-[#1D4241] text-white flex items-center justify-center shrink-0">
                    <ChatBubbleLeftIcon className="h-3.5 w-3.5" />
                  </div>
                  <p className="rounded-xl bg-slate-50 p-2.5 text-xs text-slate-400 animate-pulse">Thinking...</p>
                </div>
              )}
            </div>
            <form onSubmit={handleChatSubmit} className="flex items-center gap-2">
              <input
                value={chatDraft}
                onChange={(e) => setChatDraft(e.target.value)}
                placeholder="Ask about your evaluation..."
                className="input flex-1 py-2 text-sm"
                disabled={isChatSending}
              />
              <button type="submit" aria-label="Send message" className="btn-primary p-2.5" disabled={isChatSending || !chatDraft.trim()}>
                <PaperAirplaneIcon className="h-4 w-4" />
              </button>
            </form>
          </div>
        </aside>
      </div>
    </div>
  )
}
