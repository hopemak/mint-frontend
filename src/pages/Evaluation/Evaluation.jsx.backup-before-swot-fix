} from 'recharts'
import {
  HandThumbUpIcon,
  HandThumbDownIcon,
  MegaphoneIcon,
  ExclamationTriangleIcon,
  InformationCircleIcon,
  ChatBubbleLeftIcon,
  PaperAirplaneIcon,
  ChevronRightIcon,
  Squares2X2Icon,
  AdjustmentsHorizontalIcon,
  SparklesIcon,
  ArrowTrendingUpIcon,
} from '@heroicons/react/24/outline'
import { PageHeader, LoadingBlock, ErrorNotice } from '../../components/ui.jsx'
import { evaluation as sampleEvaluation } from '../../data/sampleData.js'
import { mlAPI } from '../../services/api.js'
import toast from 'react-hot-toast'

const riskColor = { Low: 'text-emerald-600', Medium: 'text-amber-600', High: 'text-red-600' }

const scoreLabels = [
  ['innovation', 'Innovation Score'],
  ['feasibility', 'Feasibility'],
  ['marketPotential', 'Market Potential'],
  ['technicalComplexity', 'Technical Complexity'],
  ['socialImpact', 'Social Impact'],
  ['financialViability', 'Financial Viability'],
]

function scoreTone(score) {
  if (score >= 90) return { label: 'Success', bar: 'bg-emerald-500', text: 'text-emerald-600' }
  if (score >= 75) return { label: 'Primary', bar: 'bg-[#1D4241]', text: 'text-[#1D4241]' }
  if (score >= 60) return { label: 'Warning', bar: 'bg-amber-500', text: 'text-amber-600' }
  return { label: 'Critical', bar: 'bg-red-500', text: 'text-red-600' }
}

function generateImprovements(scores) {
  const improvements = []
  
  if (scores.innovation < 75) {
    improvements.push({
      title: '🚀 Increase Innovation',
      detail: 'Research existing solutions and add unique features that differentiate your idea from competitors.'
    })
  }
  
  if (scores.feasibility < 75) {
    improvements.push({
      title: '⚙️ Strengthen Feasibility',
      detail: 'Break down implementation into smaller phases and address technical challenges early.'
    })
  }
  
  if (scores.marketPotential < 75) {
    improvements.push({
      title: '📊 Expand Market Research',
      detail: 'Conduct surveys and interviews with potential customers to validate market demand.'
    })
  }
  
  if (scores.technicalComplexity < 75) {
    improvements.push({
      title: '💻 Simplify Technical Approach',
      detail: 'Consider using existing technologies and platforms before building from scratch.'
    })
  }
  
  if (scores.socialImpact < 75) {
    improvements.push({
      title: '🌍 Enhance Social Impact',
      detail: 'Identify specific communities or groups that would benefit most from your solution.'
    })
  }
  
  if (scores.financialViability < 75) {
    improvements.push({
      title: '💰 Refine Financial Model',
      detail: 'Create detailed revenue projections and identify cost-saving opportunities.'
    })
  }
  
  if (improvements.length === 0) {
    improvements.push({
      title: '✅ Maintain Momentum',
      detail: 'Continue developing your idea and seek feedback from mentors and potential users.'
    })
    improvements.push({
      title: '📈 Plan for Scale',
      detail: 'Develop a growth strategy that includes marketing, partnerships, and funding.'
    })
  }
  
  return improvements.slice(0, 4)
}

const improvementIcons = [Squares2X2Icon, AdjustmentsHorizontalIcon, SparklesIcon, ArrowTrendingUpIcon]

