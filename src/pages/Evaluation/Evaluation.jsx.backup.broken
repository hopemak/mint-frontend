import React, { useState } from 'react'
import {
  ResponsiveContainer,
  RadarChart,
  PolarGrid,
  PolarAngleAxis,
  PolarRadiusAxis,
  Radar,
} from 'recharts'
import {
  HandThumbUpIcon,
  HandThumbDownIcon,
  MegaphoneIcon,
  ExclamationTriangleIcon,
  InformationCircleIcon,
  ChatBubbleLeftIcon,
  PaperAirplaneIcon,
  EllipsisHorizontalIcon,
  ChevronRightIcon,
  Squares2X2Icon,
  AdjustmentsHorizontalIcon,
  SparklesIcon,
  ArrowTrendingUpIcon,
} from '@heroicons/react/24/outline'
import { PageHeader, LoadingBlock, ErrorNotice } from '../../components/ui.jsx'
import { evaluation as sampleEvaluation } from '../../data/sampleData.js'
import { mlAPI } from '../../services/api.js'
import toast from 'react-hot-toast'

const riskColor = { Low: 'text-emerald-600', Medium: 'text-amber-600', High: 'text-red-600' }

const scoreLabels = [
  ['innovation', 'Innovation Score'],
  ['feasibility', 'Feasibility'],
  ['marketPotential', 'Market Potential'],
  ['technicalComplexity', 'Technical Complexity'],
  ['socialImpact', 'Social Impact'],
  ['financialViability', 'Financial Viability'],
]

function scoreTone(score) {
  if (score >= 90) return { label: 'Success', bar: 'bg-emerald-500', text: 'text-emerald-600' }
  if (score >= 75) return { label: 'Primary', bar: 'bg-primary', text: 'text-primary' }
  if (score >= 60) return { label: 'Warning', bar: 'bg-amber-500', text: 'text-amber-600' }
  return { label: 'Critical', bar: 'bg-red-500', text: 'text-red-600' }
}

// --- REAL backend feedback parsing ---
// app/models/idea_evaluator.py's _generate_feedback() returns ONE string:
// several sentences, optionally ending with "Recommendations: A; B; C".
// This splits that real, per-idea text into (1) general commentary
// sentences for "Smart Suggestions" and (2) the specific recommendations
// for "Suggested Improvements" — instead of ignoring it and showing
// generic bucketed/hardcoded text.
function parseBackendFeedback(feedbackStr) {
  if (!feedbackStr) return { suggestions: [], recommendations: [] }
  const recMatch = feedbackStr.match(/Recommendations:\s*(.+)$/)
  const mainText = recMatch ? feedbackStr.slice(0, recMatch.index).trim() : feedbackStr.trim()
  const suggestions = mainText.split(/(?<=\.)\s+/).filter(Boolean)
  const recommendations = recMatch
    ? recMatch[1].split(';').map((s) => s.trim()).filter(Boolean)
    : []
  return { suggestions, recommendations }
}

// Maps each backend recommendation phrase (from _generate_feedback's
// `recommendations` list) to a short card title, so "Suggested
// Improvements" reads as clean title+detail cards instead of raw
// sentences, while still being 100% driven by the real backend text.
const RECOMMENDATION_TITLES = [
  { match: /novelty/i, title: 'Increase Innovation' },
  { match: /implementation plan/i, title: 'Strengthen Feasibility' },
  { match: /market research/i, title: 'Deepen Market Research' },
  { match: /social impact/i, title: 'Strengthen Social Impact' },
  { match: /financial projections/i, title: 'Refine Financial Plan' },
]

function titleForRecommendation(text) {
  const found = RECOMMENDATION_TITLES.find((r) => r.match.test(text))
  return found ? found.title : 'Suggested Improvement'
}

// Fallback ONLY used when there's no backend text at all (e.g. showing
// sample/offline data) — the real path above always wins when available.
const fallbackFeedback = (data) => {
  const suggestions = []
  if (data.innovation_score > 80) suggestions.push('🌟 Your idea shows exceptional innovation and creative thinking!')
  else if (data.innovation_score > 60) suggestions.push('💡 Good innovation level - consider adding more disruptive elements.')
  else suggestions.push('📈 Your idea could benefit from more innovative approaches.')

  if (data.market_potential > 80) suggestions.push('🎯 Excellent market potential - you have identified a clear opportunity.')
  else if (data.market_potential > 60) suggestions.push('📊 Market opportunity exists - refine your targeting strategy.')
  else suggestions.push('🔍 Consider expanding your market analysis and target audience.')

  if (data.feasibility > 80) suggestions.push('✅ Highly feasible - you have strong fundamentals in place.')
  else if (data.feasibility > 60) suggestions.push('⚙️ Feasibility is moderate - address key implementation challenges.')
  else suggestions.push('🚧 Feasibility needs improvement - break down implementation steps.')

  return suggestions
}

const fallbackImprovements = [
  { title: 'Refine user interface', detail: 'Simplify onboarding to reduce drop-off.' },
  { title: 'Target a specific niche', detail: 'Narrow initial launch to one region.' },
  { title: 'Optimize unit economics', detail: 'Reduce customer acquisition cost.' },
]

const improvementIcons = [Squares2X2Icon, AdjustmentsHorizontalIcon, SparklesIcon, ArrowTrendingUpIcon]

export default function Evaluation() {
  const [evaluationData, setEvaluationData] = useState(null)
  const [loading, setLoading] = useState(false)
  const [isFallback, setIsFallback] = useState(false)
  const [chatDraft, setChatDraft] = useState('')
  const [chatMessages, setChatMessages] = useState([])
  const [isChatSending, setIsChatSending] = useState(false)
  const [showForm, setShowForm] = useState(false)

  const [formData, setFormData] = useState({
    title: 'AgriSense AI - Precision Agriculture',
    description: 'AI-powered platform for Ethiopian farmers using computer vision and IoT sensors for crop disease detection with 95% accuracy. Provides real-time SMS alerts.',
    category: 'Agriculture',
    industry: 'AI/ML',
    target_market: '5 million smallholder farmers in Ethiopia, 1 million with smartphone access',
    business_model: 'Freemium SaaS - Premium at $5/month, Enterprise at $200/month',
    innovation_level: 8,
    market_potential: 90,
    feasibility: 78,
    financial_plan: 72,
    social_impact: 95,
    team_capability: 75,
    overall_risk: 25,
  })

  const handleChange = (e) => {
    const { name, value } = e.target
    setFormData({ ...formData, [name]: value })
  }

  const handleNew = () => {
    setFormData({
      title: '',
      description: '',
      category: '',
      industry: '',
      target_market: '',
      business_model: '',
      innovation_level: 5,
      market_potential: 70,
      feasibility: 70,
      financial_plan: 70,
      social_impact: 70,
      team_capability: 70,
      overall_risk: 40,
    })
    setEvaluationData(null)
    setIsFallback(false)
    setShowForm(true)
    toast.success('Ready for a new idea! 🚀')
  }

  const handlePreview = async () => {
    if (!formData.title || !formData.description) {
      toast.error('Please enter your idea title and description first')
      return
    }

    setLoading(true)
    try {
      const response = await mlAPI.evaluate({
        title: formData.title,
        description: formData.description,
        category: formData.category || 'General',
        industry: formData.industry || 'Technology',
        target_market: formData.target_market || '',
        business_model: formData.business_model || '',
        innovation_score: formData.innovation_level * 10,
        market_potential: parseInt(formData.market_potential),
        feasibility: parseInt(formData.feasibility),
        financial_plan: parseInt(formData.financial_plan),
        social_impact: parseInt(formData.social_impact),
        team_capability: parseInt(formData.team_capability),
        overall_risk: parseInt(formData.overall_risk),
      })

      console.log('✅ Backend Response:', response)

      if (response.data?.success) {
        const data = response.data.data

        // Use the REAL backend-generated feedback text instead of a
        // generic client-side heuristic.
        const { suggestions, recommendations } = parseBackendFeedback(data.feedback)
        const aiFeedback = suggestions.length ? suggestions : fallbackFeedback({
          innovation_score: data.innovation_score || 70,
          market_potential: data.market_potential || 70,
          feasibility: data.feasibility || 70,
        })

        // Build "Suggested Improvements" from the backend's own
        // recommendations (real, per-idea) instead of a fixed array.
        const suggestedImprovements = recommendations.length
          ? recommendations.map((text) => ({ title: titleForRecommendation(text), detail: text }))
          : fallbackImprovements

        setEvaluationData({
          overallScore: data.overall_score || 80,
          rating: data.rating || 'Good',
          scores: {
            innovation: data.innovation_score || 70,
            feasibility: data.feasibility || 70,
            marketPotential: data.market_potential || 70,
            technicalComplexity: data.technical_complexity || 50,
            socialImpact: data.social_impact || 70,
            financialViability: data.financial_viability || 70,
          },
          radar: [
            { subject: 'Innovation', value: data.innovation_score || 70 },
            { subject: 'Feasibility', value: data.feasibility || 70 },
            { subject: 'Market', value: data.market_potential || 70 },
            { subject: 'Technical', value: data.technical_complexity || 50 },
            { subject: 'Social', value: data.social_impact || 70 },
            { subject: 'Financial', value: data.financial_viability || 70 },
          ],
          risks: [
            { name: 'Technological', level: data.risk_score > 50 ? 'Medium' : 'Low' },
            { name: 'Market Acceptance', level: data.market_potential > 70 ? 'Low' : 'Medium' },
            { name: 'Regulatory', level: 'High' },
          ],
          swot: data.swot_analysis || {
            strengths: ['Strong technical founding team', 'Clear early customer traction'],
            weaknesses: ['Limited go-to-market budget', 'Single-market dependency'],
            opportunities: ['Growing regional demand', 'Government grant alignment'],
            threats: ['New entrants with more capital', 'Regulatory delays possible'],
          },
          approvalStatus: data.approval_status || 'Under Review',
          suggestedImprovements,
          feedback: aiFeedback,
        })
        setIsFallback(false)
        toast.success('✅ Evaluation complete!')
      } else {
        toast.error('Evaluation failed')
      }
    } catch (error) {
      console.error('❌ Backend Error:', error)
      const enhancedSample = {
        ...sampleEvaluation,
        feedback: fallbackFeedback({
          innovation_score: 75,
          market_potential: 80,
          feasibility: 70,
        }),
        suggestedImprovements: sampleEvaluation.suggestedImprovements || fallbackImprovements,
      }
      setEvaluationData(enhancedSample)
      setIsFallback(true)
      toast.error('⚠️ Using sample data - Backend not available')
    } finally {
      setLoading(false)
    }
  }

  const displayData = evaluationData || sampleEvaluation

  const aiSuggestions = displayData.feedback || fallbackFeedback({
    innovation_score: displayData.scores?.innovation || 75,
    market_potential: displayData.scores?.marketPotential || 80,
    feasibility: displayData.scores?.feasibility || 70,
  })

  const handleChatSubmit = async (e) => {
    e.preventDefault()
    const query = chatDraft.trim()
    if (!query) return

    setChatMessages((prev) => [...prev, { role: 'user', text: query }])
    setChatDraft('')
    setIsChatSending(true)

    try {
      const { data } = await mlAPI.chat(query, {
        title: displayData.title || formData.title,
        overallScore: displayData.overallScore,
        scores: {
          innovation_score: displayData.scores?.innovation,
          feasibility: displayData.scores?.feasibility,
          market_potential: displayData.scores?.marketPotential,
          technical_complexity: displayData.scores?.technicalComplexity,
          social_impact: displayData.scores?.socialImpact,
          financial_viability: displayData.scores?.financialViability,
        },
        feedback: Array.isArray(displayData.feedback) ? displayData.feedback.join(' ') : displayData.feedback,
      })
      const replyText = data?.data?.response || data?.response || "Sorry, I couldn't generate a response."
      setChatMessages((prev) => [...prev, { role: 'assistant', text: replyText }])
    } catch (err) {
      console.error('Chat error:', err)
      setChatMessages((prev) => [...prev, { role: 'assistant', text: 'The AI assistant is unavailable right now — check that ml-ai-service is running.' }])
      toast.error('Chat request failed')
    } finally {
      setIsChatSending(false)
    }
  }

  if (loading) return <LoadingBlock label="Running AI evaluation..." />

  return (
    <div>
      <PageHeader
        eyebrow="AI Evaluation"
        title="AI Idea Evaluation"
        action={
          <div className="flex items-center gap-2">
            <button type="button" className="btn-outline" onClick={handlePreview}>
              Preview
            </button>
            <button type="button" className="btn-primary" onClick={handleNew}>
              + New
            </button>
          </div>
        }
      />
      {isFallback && <ErrorNotice />}

      {showForm && (
        <div className="card p-4 mb-6 bg-gray-50 border border-gray-200">
          <h3 className="font-medium text-gray-700 mb-3">Idea Details</h3>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="md:col-span-2">
              <label className="block text-sm font-medium text-gray-700 mb-1">Title *</label>
              <input
                type="text"
                name="title"
                value={formData.title}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
                placeholder="Enter your idea title"
              />
            </div>
            <div className="md:col-span-2">
              <label className="block text-sm font-medium text-gray-700 mb-1">Description *</label>
              <textarea
                name="description"
                value={formData.description}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
                rows="3"
                placeholder="Describe your idea in detail..."
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Category</label>
              <select
                name="category"
                value={formData.category}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
              >
                <option value="">Select Category</option>
                <option value="Agriculture">Agriculture</option>
                <option value="Healthcare">Healthcare</option>
                <option value="FinTech">FinTech</option>
                <option value="EdTech">EdTech</option>
                <option value="CleanTech">CleanTech</option>
                <option value="AI/ML">AI/ML</option>
              </select>
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Industry</label>
              <select
                name="industry"
                value={formData.industry}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
              >
                <option value="">Select Industry</option>
                <option value="Technology">Technology</option>
                <option value="Healthcare">Healthcare</option>
                <option value="Finance">Finance</option>
                <option value="Agriculture">Agriculture</option>
                <option value="Education">Education</option>
              </select>
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Innovation Level (1-10)</label>
              <input
                type="range"
                name="innovation_level"
                min="1"
                max="10"
                value={formData.innovation_level}
                onChange={handleChange}
                className="w-full"
              />
              <div className="flex justify-between text-xs text-gray-500">
                <span>Low</span>
                <span className="font-medium text-primary">{formData.innovation_level}/10</span>
                <span>High</span>
              </div>
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Market Potential (0-100)</label>
              <input
                type="number"
                name="market_potential"
                value={formData.market_potential}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
                min="0"
                max="100"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Feasibility (0-100)</label>
              <input
                type="number"
                name="feasibility"
                value={formData.feasibility}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
                min="0"
                max="100"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Financial Plan (0-100)</label>
              <input
                type="number"
                name="financial_plan"
                value={formData.financial_plan}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
                min="0"
                max="100"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Social Impact (0-100)</label>
              <input
                type="number"
                name="social_impact"
                value={formData.social_impact}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
                min="0"
                max="100"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Team Capability (0-100)</label>
              <input
                type="number"
                name="team_capability"
                value={formData.team_capability}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
                min="0"
                max="100"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Risk Score (0-100)</label>
              <input
                type="number"
                name="overall_risk"
                value={formData.overall_risk}
                onChange={handleChange}
                className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
                min="0"
                max="100"
              />
            </div>
          </div>
          <div className="mt-4 flex gap-2">
            <button onClick={handlePreview} className="btn-primary px-6">
              Evaluate
            </button>
            <button onClick={() => setShowForm(false)} className="btn-outline px-6">
              Cancel
            </button>
          </div>
        </div>
      )}

      <div className="card p-6 mb-6 bg-gradient-to-r from-primary via-primary-600 to-accent-500 text-white">
        <p className="text-sm opacity-80 mb-1 flex items-center gap-1.5">
          AI Overall Score
          <InformationCircleIcon className="h-4 w-4 opacity-80" title="Composite score across all evaluation dimensions" />
        </p>
        <div className="flex items-center gap-4">
          <span className="font-heading text-5xl font-bold">{displayData.overallScore}</span>
          <span className="badge bg-white/20 text-white">{displayData.rating}</span>
        </div>
      </div>

      <div className="grid sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
        {scoreLabels.map(([key, label]) => {
          const tone = scoreTone(displayData.scores[key])
          return (
            <div key={key} className="card p-4">
              <p className="text-xs text-slate-500 mb-1">{label}</p>
              <p className="font-heading text-2xl font-semibold text-ink dark:text-white mb-2">{displayData.scores[key]}</p>
              <div className="h-1.5 rounded-full bg-slate-100 dark:bg-primary-700 overflow-hidden mb-1.5">
                <div className={`h-full ${tone.bar}`} style={{ width: `${displayData.scores[key]}%` }} />
              </div>
              <span className={`text-xs font-medium ${tone.text}`}>{tone.label}</span>
            </div>
          )
        })}
      </div>

      <div className="grid lg:grid-cols-4 gap-6">
        <div className="lg:col-span-3">
          <div className="grid lg:grid-cols-3 gap-4 mb-6">
            <div className="card p-5">
              <h2 className="font-heading font-semibold text-ink dark:text-white mb-2">Multi-Dimensional Analysis</h2>
              <p className="text-sm text-slate-500 mb-2">Visualizes the overall balance of this idea.</p>
              <ResponsiveContainer width="100%" height={260}>
                <RadarChart data={displayData.radar}>
                  <PolarGrid stroke="#E2E8F0" />
                  <PolarAngleAxis dataKey="subject" tick={{ fontSize: 11 }} />
                  <PolarRadiusAxis tick={false} axisLine={false} />
                  <Radar dataKey="value" stroke="#1D4241" fill="#1D4241" fillOpacity={0.35} />
                </RadarChart>
              </ResponsiveContainer>
            </div>

            <div className="card p-5">
              <h2 className="font-heading font-semibold text-ink dark:text-white">Risk Analysis</h2>
              <p className="text-sm text-slate-500 mb-4">Identified risks with:</p>
              <div className="space-y-3">
                {displayData.risks.map((r) => (
                  <div key={r.name} className="rounded-xl border border-slate-100 dark:border-primary-700 p-3.5">
                    <p className="text-sm font-medium text-ink dark:text-white">{r.name}</p>
                    <span className={`text-xs font-medium ${riskColor[r.level]}`}>{r.level} Risk</span>
                  </div>
                ))}
              </div>
            </div>

            <div className="card p-5">
              <h2 className="font-heading font-semibold text-ink dark:text-white mb-4">SWOT Analysis</h2>
              <div className="grid grid-cols-2 gap-3 text-sm">
                <div className="rounded-xl bg-emerald-50 border border-emerald-100 p-3.5">
                  <p className="flex items-center gap-1.5 font-medium text-emerald-700 mb-1.5"><HandThumbUpIcon className="h-4 w-4" /> Strengths</p>
                  <ul className="text-emerald-700/80 space-y-1 list-disc list-inside">
                    {displayData.swot.strengths.map((s) => <li key={s}>{s}</li>)}
                  </ul>
                </div>
                <div className="rounded-xl bg-red-50 border border-red-100 p-3.5">
                  <p className="flex items-center gap-1.5 font-medium text-red-600 mb-1.5"><HandThumbDownIcon className="h-4 w-4" /> Weaknesses</p>
                  <ul className="text-red-600/80 space-y-1 list-disc list-inside">
                    {displayData.swot.weaknesses.map((s) => <li key={s}>{s}</li>)}
                  </ul>
                </div>
                <div className="rounded-xl bg-primary/10 border border-primary/20 p-3.5">
                  <p className="flex items-center gap-1.5 font-medium text-primary mb-1.5"><MegaphoneIcon className="h-4 w-4" /> Opportunities</p>
                  <ul className="text-primary/80 space-y-1 list-disc list-inside">
                    {displayData.swot.opportunities.map((s) => <li key={s}>{s}</li>)}
                  </ul>
                </div>
                <div className="rounded-xl bg-accent-50 border border-accent-200 p-3.5">
                  <p className="flex items-center gap-1.5 font-medium text-accent-600 mb-1.5"><ExclamationTriangleIcon className="h-4 w-4" /> Threats</p>
                  <ul className="text-accent-600/80 space-y-1 list-disc list-inside">
                    {displayData.swot.threats.map((s) => <li key={s}>{s}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div className="card p-5 flex items-center justify-between">
            <h2 className="font-heading font-semibold text-ink dark:text-white">Approval Status</h2>
            <span className="badge bg-emerald-100 text-emerald-700 text-sm">{displayData.approvalStatus}</span>
          </div>
        </div>

        <aside className="lg:col-span-1 space-y-6 h-fit lg:sticky lg:top-20">
          <div className="card p-5">
            <h2 className="font-heading font-semibold text-ink dark:text-white mb-3">AI Generated Feedback</h2>
            <div className="flex items-center justify-between mb-3">
              <p className="text-sm font-medium text-ink dark:text-white">Smart Suggestions</p>
              <button type="button" aria-label="More options" className="text-slate-400 hover:text-slate-600">
                <EllipsisHorizontalIcon className="h-4 w-4" />
              </button>
            </div>
            <div className="space-y-2.5 mb-3">
              {aiSuggestions.map((msg) => (
                <div key={msg} className="flex gap-2">
                  <div className="h-6 w-6 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                    <ChatBubbleLeftIcon className="h-3.5 w-3.5" />
                  </div>
                  <p className="rounded-xl bg-slate-50 dark:bg-primary-700 p-2.5 text-xs text-slate-600 dark:text-slate-200">{msg}</p>
                </div>
              ))}
              {chatMessages.map((m, i) => (
                <div key={i} className={`flex gap-2 ${m.role === 'user' ? 'flex-row-reverse' : ''}`}>
                  <div className={`h-6 w-6 rounded-full flex items-center justify-center shrink-0 ${m.role === 'user' ? 'bg-accent text-primary-800' : 'bg-primary text-white'}`}>
                    <ChatBubbleLeftIcon className="h-3.5 w-3.5" />
                  </div>
                  <p className={`rounded-xl p-2.5 text-xs ${m.role === 'user' ? 'bg-accent-50 text-ink dark:text-white' : 'bg-slate-50 dark:bg-primary-700 text-slate-600 dark:text-slate-200'}`}>
                    {m.text}
                  </p>
                </div>
              ))}
              {isChatSending && (
                <div className="flex gap-2">
                  <div className="h-6 w-6 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                    <ChatBubbleLeftIcon className="h-3.5 w-3.5" />
                  </div>
                  <p className="rounded-xl bg-slate-50 dark:bg-primary-700 p-2.5 text-xs text-slate-400 animate-pulse">Thinking…</p>
                </div>
              )}
            </div>
            <form onSubmit={handleChatSubmit} className="flex items-center gap-2">
              <input
                value={chatDraft}
                onChange={(e) => setChatDraft(e.target.value)}
                placeholder="Ask about your scores, risks, or how to improve..."
                className="input flex-1 py-2 text-sm"
                disabled={isChatSending}
              />
              <button type="submit" aria-label="Send message" className="btn-primary p-2.5" disabled={isChatSending || !chatDraft.trim()}>
                <PaperAirplaneIcon className="h-4 w-4" />
              </button>
            </form>
          </div>

          <div className="card p-5">
            <div className="flex items-center justify-between mb-3">
              <h2 className="font-heading font-semibold text-ink dark:text-white">Suggested Improvements</h2>
              <button type="button" aria-label="More options" className="text-slate-400 hover:text-slate-600">
                <EllipsisHorizontalIcon className="h-4 w-4" />
              </button>
            </div>
            <div className="space-y-1">
              {displayData.suggestedImprovements.map((s, i) => {
                const Icon = improvementIcons[i % improvementIcons.length]
                return (
                  <button
                    key={s.title + i}
                    type="button"
                    className="w-full flex items-center gap-3 rounded-xl p-2 -mx-2 text-left hover:bg-slate-50 dark:hover:bg-primary-700 transition-colors"
                  >
                    <div className="h-9 w-9 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                      <Icon className="h-5 w-5" />
                    </div>
                    <div className="min-w-0 flex-1">
                      <p className="text-sm font-medium text-ink dark:text-white truncate">{s.title}</p>
                      <p className="text-xs text-slate-500 truncate">{s.detail}</p>
                    </div>
                    <ChevronRightIcon className="h-4 w-4 text-slate-300 shrink-0" />
                  </button>
                )
              })}
            </div>
          </div>
        </aside>
      </div>
    </div>
  )
}
